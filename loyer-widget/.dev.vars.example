# Copier ce fichier en .dev.vars pour tester en local (.dev.vars n'est jamais envoyé sur git)
# EMAIL_MODE=log : l'e-mail du lead est affiché dans le terminal au lieu d'être envoyé
EMAIL_MODE=log
LEAD_EMAIL=contact@immobuild.lu
# Pour tester un vrai envoi en local, retirer EMAIL_MODE et ajouter :
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=ImmoBuild Loyer <loyer@immobuild.lu>
# Avis de Resend (copie au visiteur non livrée), seulement pour tester le webhook en local :
# RESEND_WEBHOOK_SECRET=whsec_...
# Leads en attente (panne de Resend), pour tester en local : lancer wrangler avec --kv LEADS_EN_ATTENTE
# LEAD_BACKUP_KEY=une-longue-phrase-au-hasard
